{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "MONGO_URI": "@mongo_uri",
    "AWS3_BUCKET": "@aws_bucket",
    "AWS3_REGION": "@aws_region",
    "AWS3_ACCESS_KEY_ID": "@aws_access_key_id",
    "AWS3_SECRET_ACCESS_KEY": "@aws_secret_access_key",
    "CORS_ORIGINS": "@cors_origins"
  }
}
